-- Load the Analysis_Data sheet from GROW_Analytics_Workbook.xlsx.
-- Rename the imported table to Analysis_Data.

Total Sales = SUM(Analysis_Data[Sales])

Total Profit = SUM(Analysis_Data[Profit])

Profit Margin % = DIVIDE([Total Profit], [Total Sales], 0)

Order Count = DISTINCTCOUNT(Analysis_Data[Order ID])

Customer Count = DISTINCTCOUNT(Analysis_Data[Customer ID])

Average Discount = AVERAGE(Analysis_Data[Discount])

Loss-Making Rows =
CALCULATE(
    COUNTROWS(Analysis_Data),
    Analysis_Data[Profit] < 0
)

Sales Previous Month =
CALCULATE(
    [Total Sales],
    DATEADD('Date'[Date], -1, MONTH)
)

Sales MoM Change % =
DIVIDE(
    [Total Sales] - [Sales Previous Month],
    [Sales Previous Month],
    0
)

